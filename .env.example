# Required: your Gemini API key. Never commit the real .env file.
GEMINI_API_KEY=

# Optional overrides (all can also be passed as CLI flags; CLI flags win).
# gemini-2.5-pro is the model this experiment is designed around, but as of
# late 2026 it (and Pro-tier models generally) may require a billing-enabled
# project or a grandfathered key -- see README.md "A note on model access".
# gemini-3.5-flash-lite is a free-tier fallback so the harness runs out of
# the box; swap this once you have Pro access.
GEMINI_MODEL=gemini-2.5-pro
INPUT_FOLDER=dc_data
OUTPUT_FOLDER=output
NUM_AGENTS=3
NUM_RUNS=1
AGENTS_CONFIG_PATH=agents_config.json
PRICING_CONFIG_PATH=
LOG_LEVEL=INFO
